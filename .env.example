# ============================================================================
# DEE-BOT-AGENTS v4.0 SUPREME - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in optional keys if not using FreeLLMAPI local
# Never commit your real .env file to Git!

# Master Core Port (HTTP + SSE + OpenAI API + 3D Spatial HUD)
DEE_PORT=8091

# FreeLLMAPI Local Gateway Key (running on :3001 on facu, barto, manager1)
FREELLM_API_KEY=your_freellm_api_key_here

# Optional Cloudflare Workers AI Fallback (for Whisper STT, Vision & Llama-3.3-70B)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional OpenRouter / Groq Fallback
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Optional Cluster Node Shared Secret (for Gateway :8730 and Bench :8731)
DEE_CLUSTER_TOKEN=

# Optional Auto-Start Physical Sensors on Boot (0 = manual/API, 1 = auto-start)
DEE_AUTO_EARS=0
DEE_AUTO_EYES=0
